{
  "name": "dezoomify-extension",
  "version": "1.0.1",
  "description": "Detect zoomable images in web pages and download them with dezoomify",
  "main": "background.js",
  "scripts": {
    "build": "bash -x build.sh",
    "test": "npm run test:types",
    "test:types": "tsc",
    "test:firefox": "addons-linter --enable-background-service-worker --self-hosted --warnings-as-errors dezoomify.zip",
    "test:chrome": "node scripts/test-chrome.js",
    "test:ci": "npm run build && npm run test:types && npm run test:firefox && npm run test:chrome"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovasoa/dezoomify-extension.git"
  },
  "keywords": [
    "dezoomify",
    "zoom",
    "image"
  ],
  "author": "Ophir LOJKINE",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/lovasoa/dezoomify-extension/issues"
  },
  "homepage": "https://github.com/lovasoa/dezoomify-extension#readme",
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "addons-linter": "^9.5.0",
    "typescript": "^5.9.3"
  }
}
